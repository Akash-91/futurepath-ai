# Copy this file to .env for local Docker development.
POSTGRES_DB=futurepath
POSTGRES_USER=futurepath
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://futurepath:change-me@db:5432/futurepath
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESUME_STORAGE_PATH=/app/data/resumes
MAX_RESUME_SIZE_MB=10
REDIS_URL=redis://redis:6379/0
EXTRACTOR_VERSION=r1-v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
